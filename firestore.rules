rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // A user can read their own profile; admins can read (and list) everyone.
      allow get:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Self-registration: only for your own uid, always as a pending 'user'. Nobody can self-assign admin/approved.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 80
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if
        // Admins may only change approval status (and the review audit fields) of *other* users.
        (isAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time)
        ||
        // Users may only edit their own display name — never role or status.
        (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 80);

      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
