# --- Firebase (Project settings → General → Your apps → Web app → SDK config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the SQLite database (website data) and uploaded images live (persist this directory in production)
DATA_DIR=./data
# Public base URL used for share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true": a first website publish needs admin approval before going live
REQUIRE_APPROVAL=true
