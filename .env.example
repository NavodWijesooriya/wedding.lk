# Where the SQLite database and uploaded images live (persist this directory in production)
DATA_DIR=./data
# Public base URL used for share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# First admin account, created on first start if no admin exists
ADMIN_EMAIL=admin@wedding.lk
ADMIN_PASSWORD=change-me-please
# "true": a first publish needs admin approval before going live
REQUIRE_APPROVAL=true
